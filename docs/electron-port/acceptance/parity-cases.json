        "expect": { "action": "restartProcess", "reason": "capture-restart-failed-repeatedly" }
      },
      {
        "name": "first failure retries in-process",
        "consecutiveFailureCount": 1,
        "expect": { "action": "retry", "reason": "capture-restart-failed" }
      }
    ]
  },
